require("dotenv").config();

const express = require("express");
const cors = require("cors");
const { askIMA } = require("./ai-engine");

const app = express();
const PORT = process.env.PORT || 3000;

app.use(cors());
app.use(express.json({ limit: "1mb" }));

// Accueil
app.get("/", (req, res) => {
  res.json({
    name: "IMA CORE",
    version: "1.0.0",
    status: "online",
    message: "Bienvenue dans le cerveau de IMA AI."
  });
});

// Vérification du serveur
app.get("/api/health", (req, res) => {
  res.json({
    status: "healthy",
    system: "IMA CORE"
  });
});

// Conversation intelligente
app.post("/api/chat", async (req, res) => {
  try {
    const { message } = req.body;

    if (!message || typeof message !== "string") {
      return res.status(400).json({
        error: "Veuillez envoyer une question valide."
      });
    }

    if (message.length > 10000) {
      return res.status(413).json({
        error: "Votre message est trop long."
      });
    }

    const result = await askIMA(message.trim());

    res.json({
      success: true,
      system: "IMA AI",
      provider: result.provider,
      answer: result.answer
    });

  } catch (error) {
    console.error("IMA CORE ERROR:", error.message);

    res.status(503).json({
      success: false,
      error: "IMA AI est temporairement indisponible."
    });
  }
});

// Démarrage
app.listen(PORT, () => {
  console.log("IMA CORE démarré sur le port " + PORT);
});
